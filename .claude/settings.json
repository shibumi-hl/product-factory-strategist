{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/run.sh\" status.py --hook" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/run.sh\" cost.py --prompt-hook" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/run.sh\" guard.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/run.sh\" cost.py" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/*)",
      "Bash(python analysis/*)",
      "Bash(python projects/*)",
      "Bash(py -3 scripts/*)",
      "Bash(py -3 analysis/*)",
      "Bash(py -3 projects/*)",
      "Bash(bash scripts/run.sh *)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
